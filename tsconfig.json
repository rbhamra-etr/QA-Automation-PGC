{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node", "@playwright/test"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "playwright.config.ts",
    "shared/core/**/*.ts",
    "data/**/*.ts",
    "pages/**/*.ts",
    "step-definitions/**/*.ts",
    "shared/core/configs/env.config.ts"
, "functionalities/common/step-definitions/common.api.steps.ts", "shared/apis/context.api.ts", "functionalities/toll-calculator-apis/step-definitions/toll-rate.api.steps.ts", "functionalities/common/step-definitions/common.sfdc.steps.ts", "functionalities/common/step-definitions/web-login-common.steps.ts", "functionalities/web-login-validation/step-definitions/login.web.steps.ts", "functionalities/request-fastners/request-fasteners.steps.ts", "functionalities/common/login.sfdc.steps.ts"  ]
}
